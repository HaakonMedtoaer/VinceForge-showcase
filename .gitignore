# Claude Code local-only files
.claude/settings.local.json

# Secrets / environment
.env
.env.*
!.env.example
*.key
*.pem

# Dependencies / build output
node_modules/
dist/
build/

# OS / editor clutter
.DS_Store
.vscode/

#Python bytecode
__pycache__/
*.pyc

#Tenant info
RUN/tenants.json
RUN/tenants_last_selected.json
RUN/live_get_response.json

# The web UI's optional local-persistence exception for the bearer token
# (token_store.py, opt-in - CLAUDE.md's default is "not stored anywhere in
# this project"). A live credential; never belongs in git.
RUN/webui_token.json

# Real captured API responses / run artifacts - real connection/tenant/
# environment/workflow ids, and in some cases full AWS ARNs + account id.
# Their useful content is already distilled into the docs/ and migration
# summary md - not needed for execution.
RUN/live_clone_output.json
RUN/output.json
RUN/webui_history.json
RUN/transform_restapi_probe.json
RUN/transform_restapi_probe2.json
RUN/transform_restapi_code_example.json

# Ad-hoc regeneration scratch files from testing a conversion by hand
# (e.g. re-running `cli.py classic-pipeline` to extract a Code step's
# source for pasting into Live) - real connection/tenant ids inside,
# trivially regenerated, not meant to be tracked.
RUN/*_regen.json
RUN/*_regen.*.json
RUN/*_regen.js

# Workbooks dropped into RUN/ to inspect a real run (e.g. "MMS002_OpenWhs_1.5
# test run.xlsx") - a customer's real sheet with M3 results written in.
RUN/*.xlsx

# Browser HAR captures of the builder - a whole session's requests AND
# responses, with real tenant/user/connection/workflow ids and presigned
# file URLs. Chrome leaves the bearer token out, but nothing else. The facts
# taken from one belong in docs/, not the raw file in git.
RUN/captures/*.har

# App-import run artifacts - the exact POST bodies sent (so: real
# connection/tenant/environment ids), the generated App Builder prompt with
# the app's whole source inlined, and any rows that couldn't be imported.
# Same concern as the captures above; regenerated by any re-run.
RUN/app-imports/

# Real customer files dropped here for review (e.g. a customer's own Classic
# XML export set) - not synthetic fixtures, not ours to commit. See
# RUN/synthetic/ for the hand-authored fixtures that ARE meant to be tracked.
RUN/Review/

# The prompt app import writes back into an app folder. App folders normally
# live outside this repo, but if one ever sits inside it this keeps the
# generated prompt out of git - it carries real tenant ids and inlines the
# app's whole source. Always regenerated by the next import.
app-builder-prompt.generated.md

# Not sensitive, just local run state / OS clutter - no reason to track.
RUN/converter_state.json
RUN/desktop.ini

# Design-file capture, 2026-09-10. Same real-data concern as everything
# above, and then some: a presigned CloudFront URL complete with signature
# and Key-Pair-Id, the AWS account id and bucket name, real TENANT/
# WORKFLOW/USER/CONNECTION ids, and full SQS ARNs inside definitionAsl.
# The protocol they establish is distilled into
# docs/vince-live-api-reference-prompt.md, "Design file" - which is the
# part worth keeping. Referenced by name there; local-only by design.
RUN/*design file*
RUN/*Design file*
RUN/workflow json after design file upload.txt

# Raw manual-test capture transcripts (Postman/HAR-style) - same real-data
# concern as the RUN/ files above, and their content is already distilled
# into vince-classic-to-live-migration-summary-MERGED-v2.md.
Check Data.txt
Claude test - API fields fail test.txt
Claude test - Manual build of MMS120 workflow.txt
Claude test - Mapping 2 fields to 1 cell.txt
Filter tests - Input and output.txt

# Redundant old draft, superseded by archive/Classic_to_live_converter.py
Build 0.4

# Regenerable bulk output - ~8MB of Infor M3 catalog metadata, produced by
# fetch_m3_api_catalog.py. No credentials in it, but no reason to commit
# (permanent repo bloat, and it's third-party metadata) when the script
# that generates it is tracked instead.
m3-api-catalog-full.json
m3-api-catalog*.json

# Raw execution-result dumps (tenant/user ids) - fetched for debugging, not source
RUN/filter-debug/
# The Runs inspector's saved traces and tenant sweeps (runs.write_artifact) -
# same ids, plus real customer input rows
RUN/runs/

# agent_guard.py hook audit log - tool inputs (redacted, but still local-only)
RUN/agent_audit.jsonl

# API Client secrets per Target Tenant preset (converter/api_client.py) - a credential.
RUN/api_clients.json
