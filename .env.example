# Copy this file to .env and fill in your real target ids.
# .env is gitignored - never commit real values here.
#
# These seed the "Default" Target Tenant preset in the web UI on first run
# (converter/tenants.py). Not required - without a .env, the tool still
# runs fine, you'll just start with zero presets and add one manually via
# the "+ Add" button instead.

CONNECTION_ID=CONNECTION-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TENANT_ID=TENANT-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ENVIRONMENT_ID=ENVIRONMENT-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only the generic pipeline path (cli.py pipeline / classic-pipeline) needs
# this: the ION API root INCLUDING the tenant segment, which is where a
# generated M3 bulk-execute endpoint is built from. Both the region and the
# tenant segment are per-tenant, so there is nothing to derive it from -
# take it from a real REST API step in the target tenant.
ION_API_BASE_URL=https://mingle-ionapi.eu1.inforcloudsuite.com/YOUR_TENANT
